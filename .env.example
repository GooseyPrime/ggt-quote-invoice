# Shop origin for sale + verify (no trailing slash). Set this explicitly to enable checkout.
NEXT_PUBLIC_SHOP_ORIGIN=https://goldengoosetools.com

# Display label only — never hardcode the paid amount in UI copy.
NEXT_PUBLIC_PRICE_LABEL=$9

# Gate checkout until Cos smoke-clears and Groundwork merges shop allowlist.
# Set to "true" to enable POST /api/sale for product/toolId quote-invoice.
NEXT_PUBLIC_QUOTE_INVOICE_SALE_LIVE=
